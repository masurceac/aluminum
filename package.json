{
  "name": "aluminum",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "package": "npm run helper && npm run build && electron-builder",
    "package:dir": "npm run helper && npm run build && electron-builder --dir",
    "test": "vitest run",
    "helper": "node -e \"require('child_process').execSync(process.platform==='win32' ? 'powershell -ExecutionPolicy Bypass -File helper/build-helper.ps1' : 'bash helper/build-helper.sh', {stdio:'inherit'})\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "electron",
      "electron-winstaller",
      "esbuild",
      "uiohook-napi"
    ]
  }
}
